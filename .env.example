# ============================================
# IPTV Restream Configuration
# ============================================

# Environment (development or production)
NODE_ENV=production

# Server Configuration
PORT=5000

# ============================================
# SECURITY - ADMIN MODE
# ============================================

# Enable admin mode for managing channels
# Set to "true" to enable, "false" to disable
ADMIN_ENABLED=true

# Admin password (minimum 8 characters)
# IMPORTANT: Use a strong password in production!
# Example: ADMIN_PASSWORD=MySecurePassword123!@
ADMIN_PASSWORD=ChangeMe12345

# Require admin authentication to change channels
CHANNEL_SELECTION_REQUIRES_ADMIN=false

# JWT Token expiry time
JWT_EXPIRY=24h

# ============================================
# SECURITY - CORS & ORIGINS
# ============================================

# Whitelist of allowed origins for CORS
# Leave empty to allow all origins (not recommended for production)
# Comma-separated list: https://example.com,https://app.example.com
ALLOWED_ORIGINS=

# ============================================
# STORAGE & PATHS
# ============================================

# Path where streams and data are stored
STORAGE_PATH=/streams

# ============================================
# DEPLOYMENT URLs
# ============================================

# Backend URL (used by frontend to connect)
# Leave empty to use relative paths
BACKEND_URL=http://localhost:5000

# Frontend URL (for CSRF protection, optional)
FRONTEND_URL=http://localhost

# ============================================
# DOCKER COMPOSE - PORT MAPPINGS
# ============================================

# HTTP port for Nginx
HTTP_PORT=80

# HTTPS port (uncomment to enable)
# HTTPS_PORT=443

# ============================================
# USER PERMISSIONS (optional, for Docker)
# ============================================

# User ID for file permissions
# PUID=1000

# Group ID for file permissions  
# PGID=1000

# ============================================
# ADVANCED OPTIONS
# ============================================

# FFmpeg binary path (if not in PATH)
# FFMPEG_PATH=/usr/bin/ffmpeg

# FFmpeg buffer size
# FFMPEG_BUFFER_SIZE=1024k

# Log level (debug, info, warn, error)
LOG_LEVEL=info
